+// sims2wide: replays the frame just submitted with every vertex moved halfway back towards
+// where the same polygon was in the previous frame.
+void GPU3D::BuildInterpolatedFrame() noexcept
+{
+    Looks3D.InterpPending = false;
+    if (Looks3D.RawCurrent.empty() || Looks3D.RawPrevious.empty()) return;
+
+    if (Looks3D.InterpVertexRAM.empty())
+    {
+        Looks3D.InterpVertexRAM.resize(6144);
+        Looks3D.InterpPolygonRAM.resize(2048);
+    }
+
+    u32 matched = 0;
+    const size_t frameSize = Looks3D.RawCurrent.size();
+    WideReplay(*this, true, Looks3D.InterpVertexRAM.data(), Looks3D.InterpPolygonRAM.data(), Looks3D.InterpRenderPolygonRAM.data(),
+        Looks3D.InterpNumPolygons, matched);
+    // (Mostly new polygons: a cut to another scene, nothing to smooth.)
+    Looks3D.InterpPending = Looks3D.InterpNumPolygons && matched * 2 >= frameSize;
+}
