+// sims2wide (from Pokemon FullDex): what the sharper and widescreen 3D picture and the
+// in-between frames need, kept outside GPU3D so that melonDS's own objects keep their memory
+// layout (with everything off, the output stays byte for byte melonDS's). One console.
+struct GPU3DLooks
+{
+    // 3D frame interpolation: a game that updates its 3D scene every second display frame
+    // (30 fps) gets an in-between picture, built from the previous and the new geometry, on the
+    // first of those two frames. Only what is shown changes, never what the game sees.
+    bool InterpolationEnabled = false;
+    u32 InterpolatedFrames = 0; // statistics
+
+    // Everything SubmitPolygon reads, recorded per call (only while interpolation or the wide
+    // picture is on) so that a frame can be submitted again: with vertices halfway between two
+    // frames, or with a wider view.
+    struct RawPolygon
+    {
+        Vertex Vertices[4];
+        u32 PolygonMode, PolygonAttr, TexParam, TexPalette;
+        u32 Viewport[6];
+        u32 NumConsecutivePolygons;
+        bool StripStart; // no previous strip polygon to attach to
+    };
+    std::vector<RawPolygon> RawCurrent;   // frame being submitted
+    std::vector<RawPolygon> RawPrevious;  // last frame that was flushed
+    bool InReplay = false;
+    // How many polygons and vertices SubmitPolygon takes: the DS's memory, more for the wide lists.
+    u32 PolygonLimit = 2048, VertexLimit = 6144;
+    u64 VBlankCount = 0, LastFlushVBlank = 0;
+    bool InterpPending = false;   // an in-between frame is ready to be shown
+    bool InterpShowReal = false;  // the real frame must be drawn on the next display frame
+    std::vector<Vertex> InterpVertexRAM;
+    std::vector<Polygon> InterpPolygonRAM;
+    std::array<Polygon*,2048> InterpRenderPolygonRAM {};
+    u32 InterpNumPolygons = 0;
+};
+extern GPU3DLooks Looks3D;
+
 class Renderer3D
 {
